# ==============================================================================
# This file IS the architecture.
#
# It is checked in CI. A violation fails the build, which means adding a
# dependency between modules is a visible, reviewed change to this file -- not an
# `import` someone slips in at midnight.
#
# See docs/02-architecture.md SS2-3.
# ==============================================================================

[importlinter]
root_package = insightlm
include_external_packages = True

# ------------------------------------------------------------------ layering
[importlinter:contract:hexagonal-layers]
name = Hexagonal layering holds inside every module
type = layers
layers =
    adapters
    application
    ports
    domain
containers =
    insightlm.identity
    insightlm.documents
    insightlm.retrieval
    insightlm.recruiting
    insightlm.governance
    insightlm.evaluation
exhaustive = false

# --------------------------------------------------------------- module graph
# Delivery sits above the modules; the shared kernel sits below everything.
# `governance` is deliberately low: every module audits, so everything may depend
# on it, and it may depend on nothing but shared.
[importlinter:contract:module-dependency-direction]
name = Module dependencies point one way
type = layers
layers =
    insightlm.api : insightlm.worker
    insightlm.recruiting
    insightlm.retrieval
    insightlm.documents
    insightlm.identity
    insightlm.governance
    insightlm.shared
exhaustive = false

# ------------------------------------------------------------- domain purity
[importlinter:contract:domain-purity]
name = Domain layers touch no infrastructure
type = forbidden
source_modules =
    insightlm.identity.domain
    insightlm.documents.domain
    insightlm.retrieval.domain
    insightlm.recruiting.domain
    insightlm.governance.domain
    insightlm.evaluation.domain
    insightlm.shared.domain
forbidden_modules =
    sqlalchemy
    alembic
    fastapi
    starlette
    httpx
    redis
    arq
    boto3
    pydantic
    pydantic_settings
    structlog
    jwt
    argon2

# ------------------------------------------------------- ports stay abstract
# A port that imports an adapter has inverted the dependency it exists to invert.
[importlinter:contract:ports-are-abstract]
name = Ports declare contracts, never implementations
type = forbidden
source_modules =
    insightlm.identity.ports
    insightlm.documents.ports
    insightlm.retrieval.ports
    insightlm.recruiting.ports
    insightlm.governance.ports
    insightlm.evaluation.ports
    insightlm.shared.ports
forbidden_modules =
    sqlalchemy
    fastapi
    httpx
    redis
    arq
    boto3

# --------------------------------------------- cross-module internals are private
# The contract that carries the thesis: `recruiting` may depend on `retrieval`'s
# port and nothing else, so "recruiting is a vertical on the document engine" is a
# property of the code rather than a claim in a report.
#
# `insightlm.governance.adapters` is deliberately absent from the forbidden list.
# Governance is a shared dependency, not a peer feature -- every module audits, and
# every module's unit of work is built by extending the governance one, which is what
# makes "an identity or document change that is not audited" structurally impossible.
# Its *application* layer stays private: use cases are still nobody else's business.
[importlinter:contract:module-internals-are-private]
name = Modules reach each other only through ports
type = forbidden
source_modules =
    insightlm.identity
    insightlm.recruiting
    insightlm.retrieval
    insightlm.documents
    insightlm.evaluation
forbidden_modules =
    insightlm.identity.adapters
    insightlm.documents.adapters
    insightlm.retrieval.adapters
    insightlm.recruiting.adapters
    insightlm.identity.application
    insightlm.governance.application
    insightlm.documents.application
    insightlm.retrieval.application
    insightlm.recruiting.application
allow_indirect_imports = false

# ------------------------------------------------ the shared kernel is a leaf
[importlinter:contract:shared-is-a-leaf]
name = The shared kernel depends on no feature module
type = forbidden
source_modules =
    insightlm.shared
forbidden_modules =
    insightlm.identity
    insightlm.documents
    insightlm.retrieval
    insightlm.recruiting
    insightlm.governance
    insightlm.evaluation
    insightlm.api
    insightlm.worker

# ------------------------------------------- the shared kernel is layered too
# The kernel offers adapters (Redis limits, the SQLAlchemy unit of work) as well as
# domain types and ports. Its own layering keeps those apart, exactly as in a module.
[importlinter:contract:shared-kernel-layers]
name = The shared kernel is layered like a module
type = layers
layers =
    insightlm.shared.adapters
    insightlm.shared.ports
    insightlm.shared.domain

# --------------------------------------- only composition picks implementations
# A use case that imports a kernel adapter has chosen its own infrastructure -- the
# decision belongs to the composition root. (An `UnmeteredBudget` default in
# RunAssessment did exactly this; it is now a required dependency.)
[importlinter:contract:no-adapters-below-composition]
name = Domain, ports and use cases never import kernel adapters
type = forbidden
source_modules =
    insightlm.identity.domain
    insightlm.identity.ports
    insightlm.identity.application
    insightlm.documents.domain
    insightlm.documents.ports
    insightlm.documents.application
    insightlm.retrieval.domain
    insightlm.retrieval.ports
    insightlm.retrieval.application
    insightlm.recruiting.domain
    insightlm.recruiting.ports
    insightlm.recruiting.application
    insightlm.governance.domain
    insightlm.governance.ports
    insightlm.governance.application
    insightlm.evaluation.domain
    insightlm.evaluation.ports
forbidden_modules =
    insightlm.shared.adapters

# ----------------------------------------------- composition sits on top
# bootstrap, ask_service, erasure, instrumented and document_readiness are the
# composition layer: the
# only code that knows every module. Nothing inside a module may depend on them, or
# the wiring would leak back into what it wires.
[importlinter:contract:composition-is-on-top]
name = No module depends on the composition layer
type = forbidden
source_modules =
    insightlm.identity
    insightlm.documents
    insightlm.retrieval
    insightlm.recruiting
    insightlm.governance
    insightlm.evaluation
    insightlm.shared
forbidden_modules =
    insightlm.bootstrap
    insightlm.ask_service
    insightlm.erasure
    insightlm.instrumented
    insightlm.document_readiness
