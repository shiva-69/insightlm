          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "60 * sum(rate(insightlm_ingestion_step_duration_milliseconds_count{step=\"index\"}[5m]))",
          "legendFormat": "indexed",
          "refId": "A"
        }
      ],
      "id": 16
    },
    {
      "type": "table",
      "title": "Recent traces (click through to Tempo)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
