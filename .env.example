# Copy to .env for local development. compose.yaml sets these itself.
ENVIRONMENT=local
DEBUG=false

# Privileged DSN -- used by Alembic only. Runtime traffic uses the restricted role
# below, because a superuser bypasses row-level security unconditionally.
DATABASE_URL=postgresql+asyncpg://insightlm:insightlm@localhost:5432/insightlm
DATABASE_APP_ROLE=insightlm_app
DATABASE_APP_PASSWORD=insightlm_app

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=insightlm
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
INVITATION_TTL_SECONDS=604800

OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
LOG_JSON=true
