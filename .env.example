# Copy to .env for local development. compose.yaml sets these itself.
ENVIRONMENT=local
DEBUG=false

# Privileged DSN -- used by Alembic only. Runtime traffic uses the restricted role
# below, because a superuser bypasses row-level security unconditionally.
DATABASE_URL=postgresql+asyncpg://insightlm:insightlm@localhost:5432/insightlm
DATABASE_APP_ROLE=insightlm_app
DATABASE_APP_PASSWORD=insightlm_app

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=insightlm
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
INVITATION_TTL_SECONDS=604800

# --- models ---------------------------------------------------------------
# Absent, the system falls back to deterministic offline adapters: answers become
# verbatim passages rather than synthesis, and the UI says so. Set these to get
# real generation and real embeddings.
#
# ANTHROPIC_API_KEY drives answer synthesis (claude-opus-5).
# VOYAGE_API_KEY drives semantic embeddings; without it retrieval matches on
# character n-grams, which finds exact wording but not paraphrase.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GENERATION_MODEL=claude-opus-5
# Answers use a faster Gemini model than judging. compose defaults to Flash with
# thinking off (docs/07 Finding 23); set GEMINI_ASK_MODEL=gemini-2.5-pro to answer on Pro.
# GEMINI_ASK_MODEL=gemini-2.5-flash
# GEMINI_ASK_THINKING_BUDGET=0
GENERATION_EFFORT=medium

OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
LOG_JSON=true
